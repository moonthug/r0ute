generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  importFileExtension = "ts"
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum NodeType {
  CHAT
  REPEATER
  ROOM
  SENSOR
}

model Location {
  publicKey       String                                @id
  name            String?
  nodeType        NodeType?
  lat             Float
  lon             Float
  point           Unsupported("geography(Point, 4326)") @default(dbgenerated())
  advertTimestamp DateTime
  receivedAt      DateTime
  pathHops        PathHop[]

  @@index([name])
  @@index([point], type: Gist)
}

model PathRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  channelId        Int
  userName         String
  requestTimestamp DateTime
  receivedAt       DateTime  @default(now())
  path             PathHop[]

  @@unique([channelId, userName, requestTimestamp])
  @@index([receivedAt])
}

model PathHop {
  pathRequest       PathRequest @relation(fields: [pathRequestId], references: [id], onDelete: Cascade)
  pathRequestId     String
  position          Int
  hash              String
  /** the sender's own node, resolved from the request's userName — drawn as the map anchor */
  isSender          Boolean     @default(false)
  location          Location?   @relation(fields: [locationPublicKey], references: [publicKey])
  locationPublicKey String?

  @@id([pathRequestId, position])
  @@index([locationPublicKey])
}
