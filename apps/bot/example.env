# r0ute bot — copy to .env and fill in

# --- required ---------------------------------------------------------------

# serial port of the MeshCore companion radio
DEVICE=/dev/ttyUSB0

# postgres (with PostGIS); docker-compose.yml exposes the dev db on 5433
DATABASE_URL=postgresql://r0ute:r0ute@localhost:5433/r0ute

# --- optional ---------------------------------------------------------------

# pino log level: trace, debug, info, warn, error
LOG_LEVEL=info

# comma-separated channel names the ping responder replies on
PING_RESPONDER_CHANNELS=

# Location used for ping responder and other location-aware features
BOT_LOCATION=<lon>,<lat>

# public URL of the admin map, linked in path responder replies
BASE_URL=http://localhost:3000/p

# --- Heartbeat --------------------------------------------------------------

# Public key of companion that receives heartbeats
MONITOR_PUBLIC_KEY=


# --- MeshRank observer uplink (https://meshrank.net) ------------------------

# registration key from Account -> Observer Setup -> MQTT uplink; ties the
# observer to your account (packets are keyed by the node's public key)
MESHRANK_REGISTRATION_KEY=

# broker; defaults to the public MeshRank broker
MESHRANK_MQTT_URL=mqtts://meshrank.net:8883

# only needed if your MeshRank uplink override provides credentials
MESHRANK_MQTT_USERNAME=
MESHRANK_MQTT_PASSWORD=
