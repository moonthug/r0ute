{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate", "^generate"],
      "env": ["DATABASE_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^generate"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "migrate:deploy": {
      "cache": false
    }
  }
}
